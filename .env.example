# Environment Mode
DEBUG=True
SECRET_KEY=production-grade-super-secret-key-change-in-prod-scale-feed-2026
ALLOWED_HOSTS=localhost,127.0.0.1,web

# PostgreSQL Configuration
POSTGRES_DB=scalefeed_db
POSTGRES_USER=scalefeed_user
POSTGRES_PASSWORD=scalefeed_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache & Broker Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_CELERY_BROKER=redis://localhost:6379/2

# FastAPI Microservice
FASTAPI_HOST=localhost
FASTAPI_PORT=8001

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Celebrity Threshold for Hybrid Fan-out
CELEBRITY_FOLLOWER_THRESHOLD=25000
